# ARC-MEM Bridge — configuration d'exemple.
# Copier en `.env` puis renseigner. NE JAMAIS committer le `.env` réel (déjà gitignoré).
# Tous les secrets sont laissés VIDES ici : remplissez-les localement.

ARC_MEM_ENV=local
ARC_MEM_HOST=127.0.0.1
ARC_MEM_PORT=8791

# --- PostgreSQL / PostGIS / pgvector ---
# PostgreSQL local SANS mot de passe supporté : laisser POSTGRES_PASSWORD vide.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rag_arc
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=disable
POSTGRES_CONNECT_TIMEOUT=10

# --- Hindsight (mémoire agentique, optionnel) ---
HINDSIGHT_MODE=postgresql_direct
HINDSIGHT_BASE_URL=
HINDSIGHT_API_KEY=
HINDSIGHT_DATABASE_URL=

# --- Provider LLM : Ollama (local, OpenAI-compatible) ---
# Aucune dépendance NVIDIA NIM / OpenRouter.
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen:14b
EXTRACTION_MODEL=qwen:14b

# --- Embeddings : Ollama nomic-embed-text (768 dimensions) ---
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_API_KEY=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_EMBEDDING_DIM=768
OLLAMA_TIMEOUT=120

# --- OCR optionnel (PDF scannés) : 1 pour activer (nécessite paddleocr installé) ---
ENABLE_OCR=0
